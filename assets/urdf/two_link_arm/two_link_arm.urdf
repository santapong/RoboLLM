<?xml version="1.0"?>
<robot name="two_link_arm">
  <link name="base_link">
    <visual>
      <geometry><mesh filename="meshes/base_link.obj" scale="1 1 1"/></geometry>
      <material name="alu"><color rgba="0.7 0.7 0.75 1"/></material>
    </visual>
    <collision><geometry><mesh filename="meshes/base_link.obj" scale="1 1 1"/></geometry></collision>
    <inertial>
      <origin xyz="0.00000 0.00000 0.01000"/>
      <mass value="0.05040"/>
      <inertia ixx="1.680000e-05" ixy="-0.000000e+00" ixz="-0.000000e+00"
               iyy="1.680000e-05" iyz="-0.000000e+00" izz="3.024000e-05"/>
    </inertial>
  </link>
  <link name="link1">
    <visual>
      <geometry><mesh filename="meshes/link1.obj" scale="1 1 1"/></geometry>
      <material name="alu"><color rgba="0.7 0.7 0.75 1"/></material>
    </visual>
    <collision><geometry><mesh filename="meshes/link1.obj" scale="1 1 1"/></geometry></collision>
    <inertial>
      <origin xyz="0.00000 0.00000 0.07500"/>
      <mass value="0.04200"/>
      <inertia ixx="8.015000e-05" ixy="-0.000000e+00" ixz="-0.000000e+00"
               iyy="8.015000e-05" iyz="-0.000000e+00" izz="2.800000e-06"/>
    </inertial>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="2.0"/>
  </joint>
  <link name="link2">
    <visual>
      <geometry><mesh filename="meshes/link2.obj" scale="1 1 1"/></geometry>
      <material name="alu"><color rgba="0.7 0.7 0.75 1"/></material>
    </visual>
    <collision><geometry><mesh filename="meshes/link2.obj" scale="1 1 1"/></geometry></collision>
    <inertial>
      <origin xyz="0.00000 0.00000 0.06000"/>
      <mass value="0.03360"/>
      <inertia ixx="4.144000e-05" ixy="-0.000000e+00" ixz="-0.000000e+00"
               iyy="4.144000e-05" iyz="-0.000000e+00" izz="2.240000e-06"/>
    </inertial>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="2.0"/>
  </joint>
</robot>
