# python / venv
.venv/
.venv-lerobot/
__pycache__/
*.pyc
*.egg-info/
.uv/
# ros build
build/
install/
log/
# CI scenario outputs (stack logs embed the local user/host name — keep out of
# this PUBLIC repo; regenerate with scripts/ci/run_scenario.sh)
artifacts/ci-results/
# hypothesis example DB (self-ignores via its own .gitignore; belt-and-suspenders)
.hypothesis/
# editor / os
.vscode/
.idea/
*.swp
.DS_Store
# mcpb bundle build output (regenerate with mcpb/build_mcpb.sh)
mcpb/build/
mcpb/dist/
# webcam scan sessions (images + meshes — large / personal)
assets/scan/
# rosbag recordings (large)
assets/bags/
# local learning datasets (large and may contain personal camera footage)
datasets/
episodes/
# Local learned-policy outputs (only compact summaries under examples/ are tracked)
artifacts/
checkpoints/
outputs/train/
*.safetensors
# large binary assets (keep small ones; comment out to version meshes)
assets/**/*.stl
assets/**/*.dae
assets/**/*.stp
assets/**/*.step
assets/**/*.mp4
!assets/**/.gitkeep
# claude harness — personal overrides stay local
.claude/settings.local.json

# sim/vla-bed (SDD §12): upstream Menagerie checkout and generated/compiled scene stay out of the repo
sim/vla-bed/assets/
sim/vla-bed/scene/*.generated.xml
sim/vla-bed/.venv/
sim/vla-bed/results/**/*.mp4
MUJOCO_LOG.TXT
# LIBERO calibration videos/logs (results JSON is committed)
sim/vla-bed/results/p2b/full/videos/
sim/vla-bed/results/p2b/*.log
