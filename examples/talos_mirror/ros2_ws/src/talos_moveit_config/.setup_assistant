# Not generated by the GUI Setup Assistant -- this whole package is
# hand-authored (see package.xml's description). This file exists only so
# MoveItConfigsBuilder resolves the URDF/SRDF paths without logging a
# "Cannot infer SRDF" warning on every launch. The disable_collisions matrix
# in config/talos.srdf, unlike the rest of this package, WAS computed with
# moveit_setup_assistant's own headless `collisions_updater` CLI -- see that
# file's header comment for the exact command.
moveit_setup_assistant_config:
  urdf:
    package: talos_moveit_config
    relative_path: config/talos.urdf.xacro
  srdf:
    relative_path: config/talos.srdf
  package_settings:
    author_name: santapong
    author_email: santapong@users.noreply.github.com
