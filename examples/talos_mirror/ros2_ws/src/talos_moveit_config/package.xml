<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>talos_moveit_config</name>
  <version>0.1.0</version>
  <description>
    Our own MoveIt 2 configuration for the vendored PAL Robotics TALOS
    full-body humanoid (talos_description). No Jazzy MoveIt config exists
    upstream for TALOS, so this package is hand-authored on the same pattern
    RoboLLM's humanoid_mirror example proved for the ROBOTIS FFW: a
    mock-hardware ros2_control xacro, SRDF chain groups, and headless
    move_group launch files, all owned by this repo rather than generated by
    the GUI Setup Assistant. The disable_collisions matrix was computed with
    moveit_setup_assistant's headless `collisions_updater` CLI, not curated
    by hand.
  </description>
  <maintainer email="santapong@users.noreply.github.com">santapong</maintainer>
  <license>Apache License 2.0</license>

  <url type="repository">https://github.com/santapong/RoboLLM</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>talos_description</exec_depend>
  <exec_depend>pal_urdf_utils</exec_depend>
  <exec_depend>talos_description_calibration</exec_depend>
  <exec_depend>talos_description_inertial</exec_depend>
  <exec_depend>xacro</exec_depend>

  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_setup_assistant</exec_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
