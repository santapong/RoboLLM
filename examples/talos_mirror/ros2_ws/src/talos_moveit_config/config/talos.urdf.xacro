<?xml version="1.0"?>
<!--
  MoveIt's URDF for TALOS: the same body geometry
  talos_description/urdf/talos_full_common.urdf.xacro assembles for
  robots/talos_full_v2.urdf.xacro, minus the two pieces that don't belong in
  a headless planning config:

    * ros2_control/ros2_control.urdf.xacro: PAL's real EtherCAT driver /
      GazeboSystem block. Replaced with mock_hardware.ros2_control.xacro
      (this package), unconditionally mock_components/GenericSystem. See
      that file for why there is no vendor mock switch to reuse.
    * gripper/gripper.urdf.xacro: not in this package's group list
      (arm_l, arm_r, head, torso, leg_l, leg_r has no gripper_l/gripper_r),
      and it would add 14 extra joints (7 revolute + mimics, per hand) to
      the collision matrix for zero MoveIt-group benefit. arm_l/arm_r still
      end at a real, non-fictitious link (wrist_*_ft_tool_link, from the
      force-torque sensor macro) rather than a link that only exists because
      a gripper is attached there.
    * gazebo/gazebo.urdf.xacro: Gazebo sensor plugins; unused headless.

  Every include below and every macro call is copied verbatim from
  talos_full_common.urdf.xacro (PAL Robotics, Apache-2.0) so the actual
  robot geometry (links, joints, limits, inertials, meshes) is exactly
  what ships in talos_description, not a re-derivation.

  Required xacro args ($(arg ...)) reached by the included files: `test`
  (torso/arm/leg calibration switch) and `use_capsule_collision` (collision
  geometry style). Both declared below with the same defaults
  talos_full_common.urdf.xacro uses. `foot_collision` and `head_type` are
  also $(arg)-driven in talos_full_common itself, but here they are inlined
  as literals at the point of use instead of re-declared as args, since
  nothing in this package needs to vary them.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="talos">

  <xacro:arg name="test" default="false"/>
  <xacro:arg name="use_capsule_collision" default="false"/>

  <xacro:include filename="$(find talos_description)/urdf/capsule_collision.xacro" />
  <xacro:include filename="$(find talos_description)/urdf/torso/torso.urdf.xacro" />
  <xacro:include filename="$(find talos_description)/urdf/head/head.urdf.xacro" />
  <xacro:include filename="$(find talos_description)/urdf/arm/arm_specifics_v2.urdf.xacro" />
  <xacro:include filename="$(find talos_description)/urdf/arm/arm.urdf.xacro" />
  <xacro:include filename="$(find pal_urdf_utils)/urdf/ft_sensors/ati_talos.urdf.xacro" />
  <xacro:include filename="$(find talos_description)/urdf/leg/leg.urdf.xacro" />
  <xacro:include filename="$(find talos_description)/urdf/leg/foot_collision_thinbox.urdf.xacro" />
  <xacro:include filename="$(find talos_description_inertial)/urdf/inertial.xacro" />
  <xacro:include filename="$(find talos_description)/urdf/extras/addons.urdf.xacro" />
  <xacro:include filename="$(find talos_description)/urdf/materials.urdf.xacro" />

  <xacro:include filename="$(find talos_moveit_config)/config/mock_hardware.ros2_control.xacro" />

  <xacro:talos_torso name="torso"/>

  <xacro:talos_head name="head" parent="torso_2_link"
                     disable_gazebo_camera="true"
                     head_type="default"/>

  <xacro:talos_arm name="arm" parent="torso_2_link" side="left" reflect="1"/>
  <xacro:talos_arm name="arm" parent="torso_2_link" side="right" reflect="-1"/>

  <xacro:ft_sensor name="wrist" parent="arm_right_7_link" side="right" reflect="1"  />
  <xacro:ft_sensor name="wrist" parent="arm_left_7_link"  side="left"  reflect="-1" />

  <xacro:talos_leg prefix="left"  reflect="1"  flexibility="false"/>
  <xacro:talos_leg prefix="right" reflect="-1" flexibility="false"/>

  <xacro:talos_addons/>
  <xacro:talos_materials/>

  <xacro:talos_mock_ros2_control/>

</robot>
