#!/bin/sh
# ros2-arm (talos_mirror copy) — runs image ros2-talos:jazzy (ros2-arm:jazzy
# + Pinocchio/Pink differential IK, see ./Dockerfile) instead of
# ros2-arm:jazzy. Adapted minimally from
# ../../humanoid_mirror/docker/ros2-arm: only the image name changed below
# (docker image inspect / docker run) — subcommand structure, workspace
# auto-discovery (resolves to this file's sibling ../ros2_ws, i.e.
# examples/talos_mirror/ros2_ws), and container names are untouched so
# later agents can graft talos subcommands on with minimal diff. The
# existing subcommands below still point at humanoid_mirror/gen3_pick_place/
# robot_arm_moveit_config packages (harmless no-ops until a matching src/
# package exists in this ros2_ws) and are templates, not talos behavior yet.
#
#   ros2-arm talos                 TALOS full-body humanoid (torso, 2x7-DOF
#                        arms, 2-DOF head, 2x6-DOF legs) mock bring-up +
#                        MoveIt2 move_group + RViz (talos_moveit_config).
#                        Accepts use_rviz:=false for headless.
#   ros2-arm talos-check            acceptance check: SRDF groups, joints.json
#                        vs the live URDF, FK at home, IK for both wrists,
#                        controllers active over disjoint sets. Needs a
#                        running `ros2-arm talos` in another terminal.
#   ros2-arm sweep                  TALOS mock bring-up + a 50 Hz whole-body
#                        sine sweep (talos_mirror) + a live limit monitor in
#                        the SAME launch, which reports max excursion per
#                        group after `duration` seconds (default 10.0) and
#                        exits. Accepts duration:=N and use_rviz:=false.
#   ros2-arm track                  TALOS M3: full-body webcam BODY tracking
#                        (talos_mirror track_node) -- your skeleton
#                        (arms+legs+head+torso lean) in RViz via TF human/*,
#                        /body/observation and /body/markers, robot PARKED.
#                        synthetic:=true (default) = deterministic full-body
#                        motion generator, no camera; synthetic:=false =
#                        /dev/video0 under /opt/mpvenv. preview:=true for the
#                        mirrored webcam window (camera mode only). STAND
#                        BACK so your torso+arms are in frame -- see
#                        docs/mirror-run.md.
#   ros2-arm body-accept            TALOS M3 acceptance, synthetic tier (no
#                        camera): torso frame, per-limb visibility gates
#                        (arms/legs/head, independently), the raw-frame Pose
#                        law (with a negative control), the synthetic
#                        full-body generator. Add --ros for the topic tier
#                        (needs `ros2-arm track` running), --live for the
#                        camera tier (needs a person in frame).
#   ros2-arm mirror synthetic       TALOS M4: mock bring-up + talos_track +
#                        talos_mirror's mirror_node, ALL IN ONE launch. Your
#                        LEFT arm/leg drives the robot's RIGHT (mirror mode
#                        by default; the pelvis never moves). synthetic:=true
#                        = deterministic full-body generator, no camera;
#                        omit it for the live webcam (synthetic:=false,
#                        under /opt/mpvenv). preview:=true for the mirrored
#                        webcam window, mirror_mode:=direct for behind-you
#                        mapping. LIVE MODE: STAND BACK so torso+arms are in
#                        frame and RAISE YOUR ARMS -- at rest elbows measure
#                        0.02-0.09 visibility, below the gate, so each arm is
#                        held, not guessed; legs only mirror once your feet
#                        are in frame too (seated = arms-only, expected).
#                        RViz opens on rviz/mirror.rviz (robot + your tracked
#                        skeleton on /body/markers + human/* TF), not the
#                        robot-only config the mock bring-up ships --
#                        use_rviz:=false for headless, rviz_config:=PATH to
#                        override. /mirror_enable (std_srvs/SetBool) is the
#                        deadman; `ros2-arm stop` kills everything. Full
#                        walkthrough: docs/mirror-run.md. REPOINTED at
#                        talos_mirror below (M4) -- the
#                        `mirror`/`mirror-accept` verbs used to be humanoid_
#                        mirror templates (see the top-of-file note); that
#                        package was never vendored into THIS ros2_ws (only
#                        talos_mirror/talos_description*/talos_moveit_config
#                        are), so running them unmodified would just fail
#                        with "package 'humanoid_mirror' not found".
#   ros2-arm retarget-bench         TALOS M4 verification: round-trip +
#                        known-answer FK, the discriminating-case mutation-
#                        kill matrix (forward reach/step vs a negate-x-too
#                        and a left/right-swap-only wrong formula), and
#                        gating-transition continuity by TICK INDEX -- pure
#                        math, no ROS. Add --fk to compare arm_dirs()/
#                        leg_dirs() against MoveIt /compute_fk (needs
#                        `ros2-arm mirror` or `talos` running), --ros to
#                        check all six live controllers (needs `mirror`
#                        running). Also REPOINTED at talos_mirror, same
#                        reason as `mirror` above.
#   ros2-arm ab-bench record FILE [--duration S] [--rate HZ]
#                        c2-qp (M5): record one deterministic synthetic
#                        body-observation session to FILE (jsonl).
#   ros2-arm ab-bench replay FILE --mode direct|qp [--control-hz HZ]
#                        replay FILE through ONE retarget mode at HZ
#                        (default 50) and print its metrics.
#   ros2-arm ab-bench ab FILE [--duration S] [--rate HZ] [--control-hz HZ]
#                        record (unless --skip-record) THEN replay FILE
#                        through BOTH modes and print a side-by-side
#                        comparison: wrist Cartesian tracking error, mean
#                        jerk, joint-limit margin violations, solve time
#                        per tick. No ROS/robot needed -- pure python +
#                        pinocchio/pink under /opt/mpvenv. See
#                        tools/qp_ab_harness.py.
#   `mirror mode:=direct|qp` (default direct) -- c2-qp (M5): qp additionally
#                        runs both wrists through pink/pinocchio task-space
#                        differential IK (qp_retarget.WristQPSolver),
#                        warm-started, joint/velocity-limited from the
#                        pinocchio model, biased to the M4 direct-copy
#                        solution via a PostureTask; direct is the
#                        unmodified M4 pipeline. See mirror_node.py.
# ros2-arm — ROS2 Jazzy + MoveIt2 container for robot-arm work.
#   ros2-arm             interactive shell (MoveIt2 + ros2_control ready)
#   ros2-arm <cmd...>    run a command in the arm container
#   ros2-arm demo        launch the MoveIt2 demo (Panda arm in RViz — drag
#                        the interactive marker, hit Plan & Execute)
#   ros2-arm arm         launch the 6-joint weld_arm MoveIt demo
#   ros2-arm loop        arm demo + a repeating pick-and-place cycle
#   ros2-arm handfollow            arm demo + webcam hand-following (camera)
#   ros2-arm handfollow synthetic  arm demo + sine-sweep test target (no cam)
#   ros2-arm handfollow [synthetic] latency_probe:=true   + per-stage timing
#                        docs: handfollow-run.md (ros2_ws/docs/ in the dev ws,
#                        docs/ next to this script in the RoboLLM example)
#   ros2-arm pickplace             Gen3-lite stack + webcam gesture-driven
#                        pick-and-place (LEFT hand; fist=grip, palm=release)
#   ros2-arm pickplace synthetic   Gen3-lite stack + scripted pick-and-place
#                        (no camera); both accept key:=value overrides and
#                        rviz:=false — docs: pickplace-run.md (ros2_ws/docs/ dev ws;
#                        docs/ next to this script in RoboLLM)
#   ros2-arm wallweld              arm demo + wall CollisionObject; held
#                        CLOSED FIST autonomously welds the wall (serpentine
#                        raster + bead/spark markers), OPEN PALM aborts;
#                        wall_mode:=marker maps an ArUco marker to the wall
#   ros2-arm wallweld synthetic    scripted wall + auto-triggered weld (no
#                        camera); both accept key:=value overrides
#   ros2-arm humanoid              ROBOTIS FFW semi-humanoid (2x7-DOF arms +
#                        2-DOF head + lift) on mock hardware in RViz — the
#                        robot alone, no tracking. MoveIt ships NO humanoid;
#                        FFW is apt-installed and baked into the image.
#                        Accepts rviz:=false for headless. docs: mirror-run.md
#   ros2-arm humanoid-check        M1 acceptance: asserts the descriptions load,
#                        all 4 controllers are active over disjoint joints, and
#                        /compute_ik succeeds for BOTH 7-DOF arms. Needs a
#                        running `ros2-arm humanoid` in another terminal.
#   ros2-arm mirror synthetic      humanoid + scripted whole-body sweep (no
#                        camera): both arms raise and fold, head nods and
#                        glances, lift travels. Accepts key:=value overrides
#                        and rviz:=false. (camera mode is M4 — not yet)
#   ros2-arm mirror-accept         M2 acceptance: publish rates, joint limits,
#                        slew limits, did-it-actually-move, and whether the
#                        mock hardware follows. Needs `mirror synthetic` up.
#                        (`track` / `body-accept` above are TALOS's own,
#                        wired to talos_mirror -- see near the top.)
#   ros2-arm mirror                M4: LIVE mirroring — your arms and head
#                        drive the humanoid. Mirror mode by default (your
#                        LEFT arm -> its RIGHT). RAISE YOUR ARMS: at rest the
#                        elbows fall below the visibility gate and each arm
#                        is held, not guessed. preview:=true for the webcam
#                        window; mirror_mode:=direct for behind-you mapping.
#   ros2-arm retarget-bench        M4 verification: FK round-trip, mirror
#                        semantics, continuity, speed. Add --fk to compare
#                        our FK against MoveIt /compute_fk (needs `humanoid`
#                        running), --ros to check live arm commands.
# GUI (RViz/MoveIt) works via X passthrough + hardware GL; ~/ros2_ws mounts.
if [ "$1" = stop ]; then
    docker rm -f armloop armmoveit armdemo armview armpickplace armhandfollow armwallweld armmirror armhumanoid armtrack armtalos armsweep 2>/dev/null
    echo "stopped all arm containers"; exit 0
fi
# Workspace: prefer a vendored ros2_ws next to this script (RoboLLM
# examples/hand_follow/docker/ros2-arm layout, works for a fresh cloner),
# else the dev workspace at $HOME/ros2_ws. WS env var overrides both.
_SELFDIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
if [ -z "$WS" ]; then
    if [ -d "$_SELFDIR/../ros2_ws/src/talos_moveit_config" ] \
       || [ -d "$_SELFDIR/../ros2_ws/src/talos_mirror" ] \
       || [ -d "$_SELFDIR/../ros2_ws/src/robot_arm_moveit_config" ] \
       || [ -d "$_SELFDIR/../ros2_ws/src/gen3_pick_place" ] \
       || [ -d "$_SELFDIR/../ros2_ws/src/humanoid_mirror" ]; then
        WS=$(CDPATH= cd "$_SELFDIR/../ros2_ws" && pwd)
    else
        WS="$HOME/ros2_ws"
    fi
fi
mkdir -p "$WS/src"
DOCKNAME=""
# Set by the live `mirror` branch below to an in-container rviz2 config path
# -- when non-empty, the bash -c script backgrounds `rviz2 -d "$RVIZ_BG"`
# right after sourcing install/setup.bash, alongside the foreground ros2
# launch. Empty means no extra RViz gets started.
RVIZ_BG=""
command -v xhost >/dev/null && xhost +local:root >/dev/null 2>&1

if ! docker image inspect ros2-talos:jazzy >/dev/null 2>&1; then
    echo "ros2-talos:jazzy isn't built yet. Build it with:"
    if [ -f "$_SELFDIR/Dockerfile" ]; then
        echo "  docker build -t ros2-talos:jazzy $_SELFDIR/"
    else
        echo "  docker build -t ros2-talos:jazzy ~/ros2_ws/.docker-talos/"
    fi
    exit 1
fi

CMD="$@"
[ "$1" = demo ] && CMD="ros2 launch moveit_resources_panda_moveit_config demo.launch.py"
[ "$1" = arm ]  && CMD="ros2 launch robot_arm_moveit_config demo.launch.py"
[ "$1" = loop ] && CMD="ros2 launch robot_arm_moveit_config loop.launch.py"
if [ "$1" = handfollow ]; then
    shift
    DOCKNAME="--name armhandfollow"
    if [ "$1" = synthetic ]; then
        shift
        CMD="ros2 launch /ros2_ws/src/robot_arm_moveit_config/launch/handfollow.launch.py synthetic:=true $*"
    else
        CMD="ros2 launch /ros2_ws/src/robot_arm_moveit_config/launch/handfollow.launch.py $*"
    fi
fi
if [ "$1" = pickplace ]; then
    shift
    DOCKNAME="--name armpickplace"
    if [ "$1" = synthetic ]; then
        shift
        CMD="ros2 launch /ros2_ws/src/gen3_pick_place/launch/pickplace.launch.py synthetic:=true $*"
    else
        CMD="ros2 launch /ros2_ws/src/gen3_pick_place/launch/pickplace.launch.py $*"
    fi
fi
if [ "$1" = humanoid ]; then
    shift
    DOCKNAME="--name armhumanoid"
    CMD="ros2 launch /ros2_ws/src/humanoid_mirror/launch/mock_bringup.launch.py $*"
fi
if [ "$1" = mirror ]; then
    shift
    DOCKNAME="--name armmirror"
    # TALOS M4: mock bring-up + talos_track + mirror_node in ONE launch (see
    # the top-of-file note -- this used to be a humanoid_mirror template;
    # that package was never vendored into this ros2_ws, so it is repointed
    # at talos_mirror/launch/mirror.launch.py now that M4 exists).
    if [ "$1" = synthetic ]; then
        shift
        CMD="ros2 launch /ros2_ws/src/talos_mirror/launch/mirror.launch.py synthetic:=true $*"
    else
        # Live mirror: show BOTH the robot and the tracked human skeleton.
        # mirror.launch.py only forwards use_rviz through to mock_bringup's
        # own RViz (talos_moveit_config/rviz/talos_moveit.rviz -- robot
        # only, no /body/markers or human/* TF), and that launch file is
        # another agent's, so we do not edit it to add an rviz_config
        # argument. Instead: force its built-in RViz off (use_rviz:=false,
        # always -- one copy, ours below is the only one that can show the
        # skeleton) and start OUR OWN rviz2 on rviz/mirror.rviz from inside
        # the same container via RVIZ_BG (see near the top of this script
        # and the bash -c block at the bottom), unless the caller passed
        # use_rviz:=false (fully headless) or overrode rviz_config:=PATH.
        # rviz_config:= is a LAUNCHER-level flag, not a mirror.launch.py
        # launch argument -- strip it before forwarding the rest through.
        MIRROR_RVIZ="/ros2_ws/src/talos_mirror/rviz/mirror.rviz"
        RVIZ_ON=true
        FWD=""
        for a in "$@"; do
            case "$a" in
                use_rviz:=false) RVIZ_ON=false ;;
                use_rviz:=true) RVIZ_ON=true ;;
                rviz_config:=*) MIRROR_RVIZ="${a#rviz_config:=}" ;;
                *) FWD="$FWD $a" ;;
            esac
        done
        CMD="ros2 launch /ros2_ws/src/talos_mirror/launch/mirror.launch.py synthetic:=false use_rviz:=false$FWD"
        [ "$RVIZ_ON" = true ] && RVIZ_BG="$MIRROR_RVIZ"
    fi
fi
if [ "$1" = mirror-accept ]; then
    shift
    CMD="python3 /ros2_ws/tools/mirror_accept.py $*"
fi
if [ "$1" = track ]; then
    shift
    DOCKNAME="--name armtrack"
    CMD="ros2 launch /ros2_ws/src/talos_mirror/launch/track.launch.py $*"
fi
if [ "$1" = retarget-bench ]; then
    shift
    CMD="python3 /ros2_ws/tools/retarget_bench.py $*"
fi
if [ "$1" = ab-bench ]; then
    shift
    # c2-qp (M5) A/B harness: record one deterministic synthetic body-
    # observation session, replay it through BOTH direct and qp retarget
    # modes offline, report tracking-error/jerk/limit-margin/solve-time
    # metrics per mode. No ROS needed (pure python + pinocchio/pink), but
    # pinocchio/pink live in /opt/mpvenv -- see tools/qp_ab_harness.py.
    # Default: `ros2-arm ab-bench ab /ros2_ws/tools/ab_session.jsonl`
    CMD="/opt/mpvenv/bin/python /ros2_ws/tools/qp_ab_harness.py $*"
fi
if [ "$1" = body-accept ]; then
    shift
    # mpvenv python: mediapipe for --live, and --system-site-packages keeps
    # rclpy importable for --ros. Plain python3 has no mediapipe.
    CMD="/opt/mpvenv/bin/python /ros2_ws/tools/body_accept.py $*"
fi
if [ "$1" = humanoid-check ]; then
    shift
    CMD="ros2 run humanoid_mirror ffw_check $*"
fi
if [ "$1" = talos ]; then
    shift
    DOCKNAME="--name armtalos"
    CMD="ros2 launch /ros2_ws/src/talos_moveit_config/launch/mock_bringup.launch.py $*"
fi
if [ "$1" = talos-check ]; then
    shift
    CMD="python3 /ros2_ws/tools/talos_check.py $*"
fi
if [ "$1" = sweep ]; then
    shift
    DOCKNAME="--name armsweep"
    CMD="ros2 launch /ros2_ws/src/talos_mirror/launch/sweep.launch.py $*"
fi
if [ "$1" = wallweld ]; then
    shift
    DOCKNAME="--name armwallweld"
    if [ "$1" = synthetic ]; then
        shift
        CMD="ros2 launch /ros2_ws/src/robot_arm_moveit_config/launch/wallweld.launch.py synthetic:=true $*"
    else
        CMD="ros2 launch /ros2_ws/src/robot_arm_moveit_config/launch/wallweld.launch.py $*"
    fi
fi

# -t only when stdin really is a TTY: scripted/CI runs (acceptance tests,
# background launches) would otherwise abort with "input device is not a TTY".
DOCKTTY="-i"
[ -t 0 ] && DOCKTTY="-it"

# USB webcam is optional: --device on a missing path aborts docker run
# entirely, and only the handfollow camera mode actually needs it.
CAMDEV=""
[ -e /dev/video0 ] && CAMDEV="--device /dev/video0"

exec docker run $DOCKTTY --rm $DOCKNAME \
    --net=host --ipc=host --pid=host \
    -e DISPLAY="${DISPLAY:-:1}" \
    -e QT_X11_NO_MITSHM=1 \
    -e ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}" \
    -e ROS_LOCALHOST_ONLY="${ROS_LOCALHOST_ONLY:-0}" \
    -e RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}" \
    -e RVIZ_BG="$RVIZ_BG" \
    -v /tmp/.X11-unix:/tmp/.X11-unix:rw \
    -v "$WS:/ros2_ws" \
    -v /dev:/dev \
    --device /dev/dri \
    $CAMDEV \
    --device-cgroup-rule='c 166:* rmw' \
    --device-cgroup-rule='c 188:* rmw' \
    --group-add dialout \
    --group-add video \
    -w /ros2_ws \
    ros2-talos:jazzy \
    bash -c 'source /opt/ros/jazzy/setup.bash 2>/dev/null;
             if [ ! -f install/setup.bash ] && [ -d src/robot_arm_moveit_config ]; then
                 echo "first run: building the workspace (colcon, ~1 min)...";
                 colcon build --packages-select robot_arm_description robot_arm_moveit_config;
             fi;
             if [ -d src/gen3_pick_place ] && [ ! -d install/gen3_pick_place ]; then
                 echo "building gen3_pick_place (colcon)...";
                 colcon build --packages-select gen3_pick_place;
             fi;
             if [ -d src/humanoid_mirror ] && [ ! -d install/humanoid_mirror ]; then
                 echo "building humanoid_mirror (colcon)...";
                 colcon build --packages-select humanoid_mirror;
             fi;
             if [ -d src/talos_moveit_config ] && [ ! -d install/talos_moveit_config ]; then
                 echo "building talos description + moveit config (colcon)...";
                 colcon build --packages-select talos_description_inertial talos_description_calibration pal_urdf_utils talos_description talos_moveit_config;
             fi;
             if [ -d src/talos_mirror ]; then
                 # UNCONDITIONAL, unlike the other guards above -- talos_mirror
                 # is under active development in this example, and a stale
                 # install/ (e.g. left over from an earlier milestone, owned
                 # by root from an earlier container run, so a host-side rm
                 # cannot even clear it) would otherwise silently keep
                 # serving old retarget.py/mirror_node.py forever, which
                 # reads exactly like "my change had no effect". ament_python
                 # has no compile step, so a no-op rebuild costs under a
                 # second. NOTE: this whole block lives inside a SINGLE-
                 # QUOTED bash -c string -- no apostrophes in this comment,
                 # ever, or the quoting breaks and dash reports a baffling
                 # "fi unexpected" two lines later, nowhere near the typo.
                 echo "building talos_mirror (colcon)...";
                 colcon build --packages-select talos_mirror;
             fi;
             [ -f install/setup.bash ] && source install/setup.bash;
             if [ -n "$RVIZ_BG" ]; then
                 echo "launching rviz2 -d $RVIZ_BG in the background...";
                 rviz2 -d "$RVIZ_BG" >/tmp/mirror_rviz.log 2>&1 &
             fi;
             exec "${@:-bash}"' -- $CMD
